---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for sitemap_url in site.sitemap_urls %}
  <url>
    <loc>{{ sitemap_url.path | absolute_url | xml_escape }}</loc>
    <lastmod>{{ sitemap_url.lastmod | date: "%Y-%m-%d" }}</lastmod>
    <priority>{{ sitemap_url.priority }}</priority>
  </url>
  {% endfor %}
</urlset>
